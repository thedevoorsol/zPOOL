{
  "name": "zpool-sdk",
  "version": "0.1.1",
  "description": "zPOOL: shielded pool for any Solana token. Shield, pay privately, unshield, with proofs in the browser and a relayer paying gas.",
  "license": "BUSL-1.1",
  "homepage": "https://www.zpool.fun/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/thedevoorsol/zPOOL"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "privacy",
    "zk",
    "shielded",
    "zpool",
    "token-2022"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@lightprotocol/hasher.rs": "^0.2.1",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "ffjavascript": "^0.3.1",
    "snarkjs": "^0.7.5",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.3.0",
    "@types/snarkjs": "^0.7.9",
    "typescript": "^5.9.2",
    "tsx": "^4.19.0"
  }
}
